{
  "name": "hudoori",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-function.mjs && tsc -b && vite build",
    "build:preview": "vite build --mode preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "sync:function": "node scripts/sync-function.mjs",
    "bundle:function": "node scripts/sync-function.mjs && npx -y esbuild@0.24.2 supabase/functions/push/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/push/bundle.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.5"
  }
}
